{
  "$schema": "https://opencode.ai/theme.json",
  "version": 2,
  "standalone": true,
  "dark": {
    "hue": {
      "gray": {
        "100": "#f7f7f7",
        "200": "#e0dee4",
        "300": "#c4c5de",
        "400": "#9db0d8",
        "500": "#7a98c7",
        "600": "#5481b6",
        "700": "#3d68a1",
        "800": "#4474b3",
        "900": "#4b80c5"
      },
      "red": {
        "100": "#fdceda",
        "200": "#ff9fba",
        "300": "#dc869e",
        "400": "#bb6d84",
        "500": "#9a566a",
        "600": "#7b4051",
        "700": "#5c2a3a",
        "800": "#401624",
        "900": "#250410"
      },
      "orange": {
        "100": "#fff5ea",
        "200": "#f5cf9f",
        "300": "#d2b084",
        "400": "#b0926b",
        "500": "#8f7452",
        "600": "#70583a",
        "700": "#523e24",
        "800": "#36250f",
        "900": "#1b0e00"
      },
      "yellow": "$hue.gray",
      "green": {
        "100": "#c5fde1",
        "200": "#a9dcc3",
        "300": "#8ebca6",
        "400": "#749d89",
        "500": "#5a7f6e",
        "600": "#426253",
        "700": "#2b473a",
        "800": "#162e23",
        "900": "#03160e"
      },
      "cyan": "$hue.gray",
      "blue": {
        "100": "#d3e5fd",
        "200": "#a6c8f5",
        "300": "#8cabd3",
        "400": "#738eb2",
        "500": "#5a7393",
        "600": "#435874",
        "700": "#2d3f57",
        "800": "#19283b",
        "900": "#061221"
      },
      "purple": "$hue.gray",
      "accent": "$hue.blue",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "categorical": [
      "blue",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.200",
      "subdued": "$hue.neutral.400",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.400",
          "$focused": "#3866a1",
          "$selected": "$hue.interactive.200"
        },
        "destructive": {
          "default": "#3866a1",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "default": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "default": "$hue.red.200"
        },
        "warning": {
          "default": "$hue.orange.200"
        },
        "success": {
          "default": "$hue.green.200"
        },
        "info": {
          "default": "#cad8e6"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.800",
      "surface": {
        "offset": "$hue.neutral.700",
        "overlay": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "$hue.red.200"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#5f86be"
    },
    "scrollbar": {
      "default": "$hue.interactive.200"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#a9dcc333",
        "removed": "#ff9fba2e",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#c9ecdb",
        "removed": "#ffc1d2"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "#a9dcc347",
          "removed": "#ff9fba40"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.interactive.200",
      "function": "#d4e0ee",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "#cad8e6",
      "operator": "$hue.neutral.200",
      "punctuation": "#b9c4de"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.interactive.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.neutral.400",
      "code": "#d4e0ee",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.neutral.200",
      "strong": "$hue.neutral.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.neutral.200",
      "listEnumeration": "$hue.neutral.400",
      "image": "$hue.interactive.200",
      "imageText": "$hue.neutral.400",
      "codeBlock": "$hue.neutral.200"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    },
    "logo": {
      "gradient": {
        "start": "#d4e0ee",
        "end": "#a6c8f5"
      }
    }
  }
}
